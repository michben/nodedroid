<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><stroke android:width="1dp" android:color="#2A3A36" /><corners android:radius="22dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#1A332D" /><stroke android:width="1dp" android:color="#19C29B" /><corners android:radius="22dp" /></shape>
    </item>
    <item>
        <shape><stroke android:width="1dp" android:color="#19C29B" /><corners android:radius="22dp" /></shape>
    </item>
</selector>
