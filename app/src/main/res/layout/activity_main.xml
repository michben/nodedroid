<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paramo1d"
            android:textColor="#E8F5F1"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Vérifiez vous-même la blockchain Parano1d, sans faire confiance à personne."
            android:textColor="#8FA8A1"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/job"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/jobVerify"
                style="@style/Choice"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Vérifier" />

            <RadioButton
                android:id="@+id/jobMine"
                style="@style/Choice"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Miner" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prêt"
                android:textColor="#19C29B"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/height"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="—"
                android:textColor="#E8F5F1"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heightLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="dernier bloc vérifié"
                android:textColor="#8FA8A1"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:textColor="#B9CEC8"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/minerPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Le téléphone cherche le nonce des blocs. Un nœud Parano1d en mode extminer (PC ou serveur) ou un pool prépare les preuves : plusieurs téléphones peuvent se connecter au même nœud."
                android:textColor="#8FA8A1"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/minerRpc"
                style="@style/Field"
                android:hint="Adresse du nœud ou du pool (http://192.168.1.20:9601)"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/minerToken"
                style="@style/Field"
                android:hint="Jeton de minage (mining.key)"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/minerPayout"
                style="@style/Field"
                android:hint="Adresse de paiement o1… (facultatif)"
                android:inputType="text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/scanQr"
                    style="@style/SmallButton"
                    android:layout_marginEnd="8dp"
                    android:text="Scanner un QR code" />

                <Button
                    android:id="@+id/pasteConfig"
                    style="@style/SmallButton"
                    android:text="Coller un lien" />
            </LinearLayout>
        </LinearLayout>

        <CheckBox
            android:id="@+id/follow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:buttonTint="#19C29B"
            android:checked="true"
            android:text="Continuer à suivre les nouveaux blocs"
            android:textColor="#E8F5F1" />

        <Button
            android:id="@+id/action"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button"
            android:text="Démarrer la vérification"
            android:textAllCaps="false"
            android:textColor="#0B1412"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SectionTitle"
            android:text="Appareil détecté" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E8F5F1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#19C29B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/conditions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#8FA8A1"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="Réglages" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Puissance"
                android:textColor="#8FA8A1"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/modeAuto" style="@style/Choice" />
                <RadioButton android:id="@+id/modeEco" style="@style/Choice" />
                <RadioButton android:id="@+id/modeBalanced" style="@style/Choice" />
                <RadioButton android:id="@+id/modePerformance" style="@style/Choice" />
            </RadioGroup>

            <Switch
                android:id="@+id/heatGuard"
                style="@style/Toggle"
                android:text="Pause si le téléphone chauffe" />

            <Switch
                android:id="@+id/batteryGuard"
                style="@style/Toggle"
                android:text="Pause si batterie sous 20 % (hors charge)" />

            <Switch
                android:id="@+id/chargingOnly"
                style="@style/Toggle"
                android:text="Uniquement pendant la charge" />

            <Switch
                android:id="@+id/wifiOnly"
                style="@style/Toggle"
                android:text="Uniquement en Wi-Fi" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="Journal" />

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="@drawable/card"
            android:padding="10dp">

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#B9CEC8"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </ScrollView>
    </LinearLayout>
</ScrollView>
